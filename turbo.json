{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "DATABASE_MIGRATION_URL",
    "HOSTED_EXPECTED_SHA",
    "PLAYWRIGHT_BASE_URL",
    "VERCEL_SHARE_URL",
    "WORKOUTPAL_PREVIEW_MIGRATE",
    "WORKOUTPAL_APP_URL",
    "WORKOUTPAL_DEMO_EMAIL",
    "WORKOUTPAL_DEMO_PASSWORD",
    "WORKOUTPAL_RUNTIME_LOGIN",
    "WORKOUTPAL_RUNTIME_PASSWORD",
    "WORKOUTPAL_SOURCE_REVISION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
